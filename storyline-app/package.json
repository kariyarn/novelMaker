{
  "name": "character-storyline",
  "version": "1.0.0",
  "description": "캐릭터 스토리라인",
  "main": "main.js",
  "author": "me",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build": "electron-builder --mac --dir",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "local.character.storyline",
    "productName": "캐릭터 스토리라인",
    "mac": {
      "target": "dir",
      "identity": null
    },
    "files": [
      "main.js",
      "store.js",
      "preload.js",
      "index.html",
      "storage/**",
      "styles/**",
      "src/**",
      "note/**",
      "sync/**",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "shortcutName": "캐릭터 스토리라인",
      "artifactName": "storyline-windows-setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8"
  }
}
